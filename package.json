{
  "name": "slopspot-paste",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "wrangler types && tsx scripts/fetch-model-assets.ts",
    "prebuild": "wrangler types && tsx scripts/fetch-model-assets.ts",
    "pretypecheck": "wrangler types",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run test && npm run build && wrangler deploy --config dist/server/wrangler.json",
    "typecheck": "astro check && npm run typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "pretest": "npm run typecheck:scripts",
    "test": "tsx scripts/run-checks.ts",
    "capture-fixture": "tsx scripts/capture-fixture.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.1",
    "@bufbuild/protobuf": "^2.14.1",
    "@jax-js/jax": "0.1.24",
    "@jax-js/loaders": "0.1.3",
    "astro": "^6.3.3",
    "highlight.js": "^11.11.1",
    "lit-html": "^3.3.3",
    "marked": "^18.0.3",
    "mobx": "^6.16.1",
    "sentencepiece-buf": "^0.2.1-0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20251101.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.3",
    "@webgpu/types": "0.1.71",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.63.0"
  }
}
