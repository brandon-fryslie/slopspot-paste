        data-state cross-fades them. Swapping innerHTML per state would make the
        glyph a thing the script has to remember to keep in sync
        [LAW:dataflow-not-control-flow].
      */}
      <span class="tool-dock-launcher-face" data-face="open" set:html={LAUNCHER_ICON} />
      <span class="tool-dock-launcher-face" data-face="close" set:html={LAUNCHER_CLOSE_ICON} />
    </button>
    <div class={DOCK_SELECTORS.menu} id="tool-dock-menu">
      <ul class="tool-dock-items">
        {dockTools.map((tool, i) => (
          <li class="tool-dock-slot" style={`--i:${i}`}>
            <button class={DOCK_SELECTORS.item} type="button" data-tool={tool.id}
              data-requires={requiresAttr(tool.availability)}
              aria-controls={panelDomId(tool.id)} aria-expanded="false" title={tool.hint}>
              <span class="tool-dock-icon" set:html={tool.icon} />
              <span class="tool-dock-label">{tool.label}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <script>
    // [LAW:decomposition] The dock owns exactly one thing: which tool region the
    // reader is looking at. It never touches what a tool DOES — every tool keeps its
    // own script and its own network edge — so this part can be read, changed, or
    // replaced without knowing that /api/search exists.
    //
    // The whole state machine lives in ../toolDockView, where scripts/tool-dock-view-
    // check.ts drives it under jsdom [LAW:verifiable-goals]. What remains here is the
    // page's half of the seam: this page's document is the markup the dock resolves
    // against. `resolveDock` throws by name on any broken template invariant, which is
    // the same loud failure the inline version had, moved to where it can be tested.
    import { mountDock, resolveDock } from "../toolDockView";

    mountDock(resolveDock(document));
  </script>

  <script>
    // The Listen tool's page half. Everything with judgement in it — what is said, in whose
    // voice, where we are in the conversation, which words are being said, who is speaking,
    // what a tap on the page means, when the page follows the voice — lives in ../speech,
    // ../neuralPerformer, ../listenPanel, ../shortcuts, ../readAlong and ../follow, each
    // driven by its own scripts/*-check.ts under jsdom [LAW:verifiable-goals]. What remains
    // here is the seam: this page's markup, this page's turn cards, the real worker, the
    // real AudioContext, the real animation frame, the real viewport, and the capability
    // gate.
    import { createListenPanel, listening } from "../listenPanel";
    import { shortcut } from "../shortcuts";
    import { readPreference, writePreference } from "../listenConsent";
    import { deviceStore } from "../preferenceStore";
    import { browserForm, encodeFile } from "../renditionFile";
    import { MODEL_ASSETS, allModelAssets, type ConnectionReading } from "../modelAssets";
    import { askToKeep, readResidency } from "../modelResidency";
    import { opfs } from "@jax-js/loaders";
    import { readPick, writePick } from "../voiceChoice";
    import { forgetResume, fragmentOf, linked, LINK_PREFIX, readResume, writeResume, type PrintedPage } from "../keptPlace";
    import { caretSource, createPainter, tapPlace } from "../readAlong";
    import { createFollower } from "../follow";
    import { spawnSynthesisWorker } from "../synthesisClient";
    import { createCodec, probeCodec } from "../audioCodec";
    import { KEPT_BYTES, createAudioCache, openKeptStore } from "../keptAudio";
    import { withKeptAudio } from "../keptSynthesis";
    import { watchAllowance, type DeviceSource } from "../presynthesis";
    import { MODEL_PCM } from "../unitPlayer";
    import { carrierWav, createMediaSession } from "../mediaSession";
    import { withDigests, type SpokenDigests, type SpokenPage, type Utterance } from "../speech";
    import { pagePlace, spokenPlace } from "../spokenPlace";
    import { createDigestPanel, type DigestPanel } from "../digestPanel";
    import { NOTHING_SAID, readSaid, sameSaid, writeSaid } from "../digestSpeech";
    import { reseatable } from "../listenPanel";
    import { summarizerSource } from "../summarizerSource";
    import { parseTurnSegment } from "../slug";
    import type { DigestTurn } from "../turnDigest";

    // ── the digests ─────────────────────────────────────────────────────────────────────

    // The browser's Summarizer, asked for once and read by both halves: the digest panel
    // opens one from it, and Listen's choice about saying digests is shown only where there
    // is one to produce them [LAW:one-source-of-truth].
    const summarizer = summarizerSource(self);
    // [LAW:no-shared-mutable-globals] The digest panel, owned by this script: written once by
    // the mount below and read by Listen's half, which finds null on a conversation with
    // nothing worth digesting and says nothing extra.
    let digests: DigestPanel | null = null;
    // What this script does when a turn gains its digest. The mount runs BEFORE the transport
    // below exists — digests are not Listen's to wait for — so the door is opened here and
    // answered there: nothing while there is no transport, which is the honest thing to do
    // with a digest a page without WebGPU will never say [LAW:dataflow-not-control-flow].
    let digestArrived = (): void => {};

    // [LAW:effects-at-boundaries] The digest mount: everything here is a fact only the
    // browser holds — whether it has a Summarizer at all, what this device remembers, what
    // the connection is, and which turn the reader is looking at. Every decision made from
    // them is digestPanel.ts's, driven under jsdom by scripts/digest-panel-check.ts.
    //
    // It shares this script with Listen's mount, and that is the whole reason the two are
    // one block: the narrator says each turn's digest before the turn, so ONE place has to
    // hold both the panel that derives them and the panel that says them. Wired as two
    // scripts they could only have met through a module-level global or by reading the
    // digests back out of the rendered card — a second representation of a derivation the
    // service already owns [LAW:one-source-of-truth]. Digests do not need Listen (a browser
    // with no WebGPU still gets them), so this half runs first and on its own terms, and
    // Listen's half below reads `digests` where it finds one.
    //
    // The section is absent for a conversation with nothing worth digesting (the server
    // decided that with the service's own threshold), and that absence is the whole feature
    // being off — not a case to guard around [LAW:dataflow-not-control-flow].
    const ask = document.querySelector<HTMLElement>(".digest-ask");
    const conversation = document.querySelector<HTMLElement>(".conversation");
    if (ask !== null && conversation !== null) {
      // [LAW:locality-or-seam] The seam this try restores. Sharing one module with Listen is
      // what lets the two panels meet, and it cost them the isolation two <script> tags gave
      // for free: a throw here — a template that lost a .digest-* part, a payload that will
      // not parse — would abort the module before Listen's mount below is ever reached, so a
      // regression in the digest markup would silently take the voice down with it. Said and
      // survived, through the same console the panel's own onFault uses: the reader loses the
      // digests, which is the half that broke [LAW:no-silent-failure].
      try {
        const part = <T extends Element>(selector: string): T => {
          const el = ask.querySelector<T>(selector);
          // [LAW:no-defensive-null-guards] The markup above is this page's own; a missing part
          // is a broken template, not a reader's browser being old.
          if (el === null) throw new Error(`digests: the ask has no ${selector}`);
          return el;
        };
        const payload = part<HTMLElement>(".digest-payload");
        const turns = JSON.parse(payload.textContent ?? "[]") as DigestTurn[];
        const panel = createDigestPanel({
          controls: {
            root: ask,
            open: part<HTMLButtonElement>(".digest-open"),
            always: part<HTMLInputElement>(".digest-always input"),
            note: part<HTMLElement>(".digest-note"),
            progress: part<HTMLProgressElement>(".digest-progress"),
          },
          conversation,
          turns,
          source: summarizer,
          // The same storage Listen's preferences use, read inside its own guard on every
          // access: a browser that blocks site data keeps no digests and remembers no yes,
          // and neither takes the page down [LAW:single-enforcer].
          store: deviceStore(() => window.localStorage),
          // [LAW:one-source-of-truth] ConnectionReading itself, the same type Listen's mount
          // reads the same navigator property through — not a second structural spelling of
          // it here, which would keep compiling while a field downloadNeedsTap later learns to
          // read went silently missing on this one of the two.
          connection: (navigator as Navigator & { readonly connection?: ConnectionReading }).connection,
          gestures: window,
          onDigest: () => digestArrived(),
          onFault: (what, error) => console.warn(`digests: ${what}`, error),
        });
