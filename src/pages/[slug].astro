---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { renderDialogueHtml } from "../renderDialogue";
import { deriveViewableDialogue } from "../overlay";
import { deriveSpineOutline } from "../spineOutline";
import { deriveUtterances } from "../speech";
import { printsOf } from "../keptPlace";
import { extractArtifacts } from "../artifacts";
import { renderCodeExportControl } from "../codeExport";
import { renderContinuationControl } from "../continuation";
import { loadViewablePaste } from "../loadPaste";
import { listPasteVersionStamps } from "../storage";
import { deriveVersionTrail, versionPath } from "../versionTrail";
import { describeTargetFault } from "../overlay";
import { fetchedAgeLabel } from "../freshnessView";
import { derivePasteMeta, isUrlPaste, sourceUrlOf, utcDate, viewLifetime } from "../types";
import { hostLabel } from "../url";
import { MAX_QUESTION_CHARS } from "../ask";
import {
  DOCK_TOOLS,
  LAUNCHER_CLOSE_ICON,
  LAUNCHER_ICON,
  TOOL,
  panelDomId,
  requiresAttr,
  type ToolId,
  MINI_ICONS,
} from "../toolDock";
// [LAW:one-source-of-truth] The dock's contract classes are interpolated from the same
// constant `resolveDock` reads, so the markup and the module cannot spell a region
// differently — a rename in toolDockView.ts lands here on the next build rather than at a
// reader's launcher. Classes NOT in this map (tool-dock-items, tool-dock-slot, tool-panel-title,
// …) stay literal on purpose: they are styling, not part of the module↔markup contract.
import { DOCK_SELECTORS } from "../toolDockView";
import { digestTurnsOf, wantsDigest } from "../turnDigest";

export const prerender = false;

const { slug } = Astro.params;

// [LAW:single-enforcer] loadViewablePaste is the one gate resolving a public paste
// from a slug (bad slug / missing → 404, soft-deleted or expired → 410) — the SAME
// gate the single-turn card route uses, so a hidden paste cannot leak on one surface
// while it is gone on the other. [LAW:dataflow-not-control-flow] its result is a
// value: the conversation or the exact response to emit.
const load = await loadViewablePaste(env.PASTES, slug, Date.now());
if (!load.ok) {
  return new Response(load.message, { status: load.status });
}
const conversation = load.conversation;

// [LAW:one-source-of-truth] Title, theme platform, and label are the display-meta
// projection derived once in derivePasteMeta — the SAME values the single-turn card
// and embed frame show. The body attribute themes the page via CSS variables; the
// label names the platform in the meta line (null for a generic platform, so absence
// of provenance renders as absence).
const { title, platform, platformLabel } = derivePasteMeta(conversation);
// [LAW:dataflow-not-control-flow] Both lifetime cases produce a meta string
// through one match — a pinned paste reads "Never disappears", never a forgotten
// branch that lies "Disappears in 0 days".
const life = viewLifetime(conversation.lifetime, Date.now());
const lifetimeLabel =
  life.kind === "pinned"
    ? "Never disappears"
    : `Disappears in ${life.days} ${life.days === 1 ? "day" : "days"}`;
const origin = conversation.origin;
// [LAW:one-source-of-truth] The original-source link is a projection of the
// captured origin (sourceUrlOf), never a second stored field. null for every
// origin without an upstream URL — text pastes, editor-authored, legacy — which
// renders as nothing below, not a placeholder ([LAW:dataflow-not-control-flow]:
// the absence is a value the template skips, not a branch that conditionally
// builds a header). The host shown in the label is derived from this URL itself
// (hostLabel), so it names the actual origin host — claude.ai, chatgpt.com, or an
// unclaimed host — and can never lie about a different provider.
const sourceUrl = sourceUrlOf(origin);

// [LAW:single-enforcer] One oEmbed discovery <link> in this paste's head is the entry
// point that makes a bare paste URL auto-embeddable: a consumer that does oEmbed
// discovery (WordPress, Notion, Discourse) reads the head, finds this, and calls the
// endpoint — no one has to know /api/oembed exists. [LAW:one-source-of-truth] it points
// at the SAME endpoint, addressed by the same absolute paste URL parsePasteRef reduces
// to a slug, so discovery cannot drift from what the endpoint serves. We advertise ONLY
// application/json+oembed because the endpoint serves only JSON — it returns 501 for xml
// on purpose — and its 200 Content-Type is literally this type, so the link's type and
// the served type agree by construction, never a text/xml+oembed link that would lie
// about a format we don't serve [FRAMING:representation]. Both URLs are absolute
// (Astro.url.origin — the SAME request-derived origin the endpoint computes from
// new URL(request.url).origin) because consumers fetch cross-origin. The paste URL is
// percent-encoded into the url= param so a consumer decodes back exactly the absolute
// paste URL. The link's title (below) is derivePasteMeta(conversation).title — the ONE
// display-meta projection every reader surface on this page already derives from, so it
// is never a second title minted here.
const oembedHref = `${Astro.url.origin}/api/oembed?url=${encodeURIComponent(`${Astro.url.origin}/${slug}`)}&format=json`;

// [LAW:one-source-of-truth] Derive the nested Dialogue ONCE, then take two disposable
// projections of it: the rendered conversation HTML and the topic outline. Both are
// pure functions of the same stored original — nothing here is persisted, and a paste
// with no turns yields an empty outline that renders nothing (a value, not a branch
// that special-cases empty).
// [LAW:single-enforcer] The one viewable-spine derivation: turns → dialogue → apply the
// authored overlay. Both the rendered conversation AND the topic outline read this one
// `dialogue`, so a redacted turn cannot leak through the outline label either.
const dialogue = deriveViewableDialogue(conversation);
const outline = deriveSpineOutline(dialogue);

// [LAW:one-source-of-truth] The spoken projection — a FOURTH reading of the same viewable
// `dialogue`, alongside the rendered HTML, the outline, and the code artifacts. Deriving it
// here rather than in the browser is what keeps the audio and the page telling one story: a
// redacted or overlay-omitted node is already absent from `dialogue`, so it can no more be
// spoken than it can be read. [LAW:effects-at-boundaries] this is the pure half; the page's
// script performs it.
const utterances = deriveUtterances(dialogue);
// Each utterance's print, index for index: what a resume position or a listen link checks
// it still names before it is used (keptPlace.ts). Derived here with the utterances, so the
// page carries exactly the prints of the text it carries.
const prints = await printsOf(utterances);

// [LAW:one-source-of-truth] The digest input — a FIFTH reading of the same viewable
// `dialogue`, selected HERE, where the derived model is, and carried to the browser as its
// result. The browser re-derives nothing of "what of a turn is readable" from the HTML it
// was sent: one selection, on the server, for the page and for the polyfill later alike.
//
// Only the turns that will be summarized ride to the browser. A turn under the threshold
// gets `none` from the service and NOTHING from the view, so carrying its prose was weight
// with no reader on the other end. Dropping them changes no behaviour: the walk reads from
// the first turn at or after where the reader is and skips what is not pending, and an
// outcome is only ever asked for a turn that was sent.
//
// This filter is NOT what makes the payload cheap, and saying so would be the kind of claim
// a measurement embarrasses: on a 40-turn transcript of a few hundred words each it removes
// nothing at all, because the bytes live in exactly the long turns that survive it — 67 KiB
// of payload against 92 KiB of rendered conversation, on every request, for every reader
// including the majority whose browser has no Summarizer. Making that cheap is a delivery
// change (one endpoint serving this and the speech payload, fetched when a reader asks for
// either), and it is ticket slopspot-turn-digest-8xc.6uw, not this line.
const digestTurns = digestTurnsOf(dialogue).filter((turn) => wantsDigest(turn.input));
// A conversation whose every turn is its own digest carries none of this: no payload, no
// ask, no script work. The threshold is the service's own (wantsDigest), asked above rather
// than restated here.
const digestable = digestTurns.length > 0;

// [LAW:one-source-of-truth] Code artifacts are a THIRD projection of the SAME viewable
// `dialogue` the renderer and outline read — extracted from its already-redacted nodes,
// never the raw stored turns, so "Copy all code" copies exactly what the reader sees and
// a redacted secret cannot leak through it [LAW:single-enforcer]. The control renders to
// nothing when the conversation carries no code (a value, not a special-cased branch).
const codeExportHtml = renderCodeExportControl(extractArtifacts(dialogue.map((d) => d.node)));

// [LAW:one-source-of-truth] The continuation bundle is another projection of the SAME
// viewable `dialogue` — the reader's redaction-applied conversation — so the copied text
// is exactly what is shown, and a redacted turn cannot leak. Renders to nothing when there
// is no readable prose to continue (a value, not a branch). Universal: it renders for every
// paste, filling the gap for pastes with no live original thread to reopen.
const continuationHtml = renderContinuationControl(dialogue);

// [LAW:one-source-of-truth] "Does this paste have an upstream page?" asked once. Both
// the version trail (archived only by the refetch path, which takes a UrlPaste) and the
// freshness surface (nothing to be fresher THAN without an upstream) read this one
// answer rather than each re-testing the origin arm.
const hasUpstream = isUrlPaste(conversation);

// [LAW:effects-at-boundaries] The trail's one extra KV read — a keys-only list of this
// slug's version stamps — gated on hasUpstream: for a text/editor paste the list is
// provably empty and the read is skipped, keeping those pastes untouched by this
// feature (the ticket's contract). Everything after is the pure derivation
// (versionTrail.ts): null = no versions = no affordance rendered.
const versionStamps = hasUpstream
  ? await listPasteVersionStamps(env.PASTES, conversation.slug)
  : [];
const trail = deriveVersionTrail(conversation, versionStamps);

// How old this snapshot is — passive provenance the reader should meet without
// tapping anything, so it rides the header meta line rather than the dock. null for
// a text/editor paste (no upstream) and for pre-stamping records (no captured
// instant): honest absence, never a fabricated one [LAW:no-silent-failure].
const fetchedAge = hasUpstream ? fetchedAgeLabel(conversation.origin) : null;

// [LAW:one-source-of-truth] Which tools this paste HAS, answered exactly once. Both
// the dock's bar (below, via `dockTools`) and each panel's `{present.x && …}` read
// this one map, so a menu item without a panel — or a panel no item can reach — is
// not a bug you can write here. `satisfies Record<ToolId, boolean>` makes the map
// compiler-checked total over the tool set: adding a ToolId in toolDock.ts forces an
// answer here rather than defaulting a new tool into absence
// [LAW:types-are-the-program].
const present = {
  // Server-rendered on every paste; their controls are client-gated, not content-gated.
  outline: outline.length > 0,
  search: true,
  ask: true,
  tldr: true,
  compare: true,
  // Content-gated: the renderers return "" when there is nothing to export or continue,
  // and the freshness/version surfaces exist only for url-arm pastes that have them.
  // Listen is content-gated on there being something to say: a paste whose spine is
  // entirely blank/whitespace yields no utterances (a fenced code block still gets an
  // "announced" utterance, never zero), and offering to read silence aloud would be a
  // promise the button can't keep.
  listen: utterances.length > 0,
  code: codeExportHtml !== "",
  continue: continuationHtml !== "",
  freshness: hasUpstream,
  versions: trail !== null,
} satisfies Record<ToolId, boolean>;
const dockTools = DOCK_TOOLS.filter((tool) => present[tool.id]);
---

<Base title={`${title} · slopspot paste`} platform={platform}>
  <link
    slot="head"
    rel="alternate"
    type="application/json+oembed"
    href={oembedHref}
    title={title}
  />
  <section class="conversation-header">
    <h1>{title}</h1>
    <p class="conversation-meta">
      {platformLabel && <span class="platform-badge">{platformLabel}</span>}
      {platformLabel && <span aria-hidden="true">·</span>}
      <span>{conversation.turns.length} turns</span>
      <span aria-hidden="true">·</span>
      <span>{lifetimeLabel}</span>
      {/*
        Snapshot age joins the meta line rather than the dock: it is something the
        reader should MEET, not something they DO, and the dock holds only tools.
        Absent for a text paste and for pre-stamping records — a value the template
        skips, not a branch [LAW:dataflow-not-control-flow].
      */}
      {fetchedAge && <span aria-hidden="true">·</span>}
      {fetchedAge && <span>{fetchedAge}</span>}
    </p>
    {sourceUrl && (
      <p class="source-origin">
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
          View original on {hostLabel(sourceUrl)} ↗
        </a>
      </p>
    )}
  </section>

  <script>
    // [LAW:decomposition] The freshness check is its own part, cut apart from the
    // sibling scripts: it owns exactly the freshness section and the one network
    // edge to /api/freshness [LAW:effects-at-boundaries]. The section renders only
    // for url-arm pastes, so its ABSENCE here is a legitimate value (this paste has
    // no upstream to check) — the wirePayloadCopy convention, not the loud throw
    // the unconditional sections use.
    import { VERDICT_WORDING, checkedAgo, isFreshnessVerdict, type FreshnessVerdict } from "../freshnessView";

    const freshnessSection = document.querySelector<HTMLElement>(".freshness");
    if (freshnessSection) {
      const form = freshnessSection.querySelector<HTMLFormElement>(".freshness-form");
      const button = freshnessSection.querySelector<HTMLButtonElement>(".freshness-check");
      const result = freshnessSection.querySelector<HTMLElement>(".freshness-result");
      // [LAW:no-silent-failure] The section always renders with its form, button,
      // and result slot, so a missing one is a broken template invariant.
      if (!form || !button || !result) {
        throw new Error("freshness section is missing its form, button, or result slot");
      }
      // [LAW:one-source-of-truth] slug from the section's own server-rendered
      // data-slug (the .tldr move), never re-derived from location.
      const slug = freshnessSection.dataset.slug ?? "";

      // [LAW:types-are-the-program] The region's total state, the TL;DR move: every
      // screen is one representable value. `checking` disables the submit button —
      // disabling also blocks Enter-key implicit submission, so overlapping checks
      // are unrepresentable [LAW:no-ambient-temporal-coupling].
      type CheckState =
        | { kind: "idle" }
        | { kind: "checking" }
        | { kind: "done"; verdict: FreshnessVerdict; checkedAt: number }
        | { kind: "error"; reason: string };

      // [LAW:dataflow-not-control-flow] One total projection of the state onto the
      // button and result line; every property is written on every transition, only
      // the values vary. Verdict wording comes from the ONE map the check script
      // also asserts (freshnessView.ts) — never retyped here
      // [LAW:one-source-of-truth]. All text lands as textContent, never innerHTML.
      const render = (s: CheckState): void => {
        button.disabled = s.kind === "checking";
        result.hidden = s.kind === "idle";
        result.classList.toggle("freshness-differs", s.kind === "done" && s.verdict === "changed");
        result.classList.toggle("freshness-error", s.kind === "error");
        result.textContent =
          s.kind === "idle"
            ? ""
            : s.kind === "checking"
              ? "Checking the live page… fetching it fresh can take a few seconds."
              : s.kind === "done"
                ? `${VERDICT_WORDING[s.verdict]} (${checkedAgo(s.checkedAt, Date.now())})`
                : s.reason;
      };

      // [LAW:effects-at-boundaries] The one network edge, mirroring the TL;DR's
      // generate(): every outcome — dropped connection, non-JSON body, error
      // status, verdict — maps to a state value [LAW:no-silent-failure].
      const check = async (): Promise<void> => {
        render({ kind: "checking" });
        const res = await fetch("/api/freshness", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ slug }),
        }).catch(() => null);
        if (!res) {
          render({ kind: "error", reason: "Network error — could not reach the freshness check." });
          return;
        }
        const body = (await res.json().catch(() => null)) as
          | { verdict?: unknown; checkedAt?: unknown; error?: string }
          | null;
        if (res.ok && body && isFreshnessVerdict(body.verdict) && typeof body.checkedAt === "number") {
          render({ kind: "done", verdict: body.verdict, checkedAt: body.checkedAt });
          return;
        }
        // [LAW:no-silent-failure] Surface the server's own reason — a 422 dead
        // link, a 410 expired — so a failed check is legible, never a blank line.
        render({ kind: "error", reason: body?.error ?? `Freshness check failed (HTTP ${res.status}).` });
      };

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        void check();
      });

      // Seat idle, then declare the tool reachable — a no-JS viewer never reaches
      // here, so the dock never offers a check button that cannot fire, and the
      // header's static age line remains the whole freshness story.
      render({ kind: "idle" });
      document.body.classList.add("freshness-ready");
    }
  </script>

  <script>
    // [LAW:effects-at-boundaries] The Compare-with control is pure client navigation: its
    // ONLY effect is location.assign at the submit boundary. parsePasteRef (src/slug.ts) is
    // the pure validator — the SAME slug law the /diff route's loader gates on
    // [LAW:one-source-of-truth] — so a typo is caught inline here rather than round-tripping
    // to a 404 [LAW:no-silent-failure]. Progressive enhancement like the copy pills: the
    // section is display:none until this script adds body.compare-ready, so a no-JS reader's
    // page is unchanged and never carries a dead control.
    import { parsePasteRef } from "../slug";

    // [LAW:no-silent-failure] The .compare-form and .conversation sections are
    // unconditional template invariants (both server-rendered every load), so a missing
    // one is a broken template, not an optional feature — throw loudly like the sibling
    // scripts here rather than silently leaving Compare hidden [LAW:no-defensive-null-guards].
    const form = document.querySelector<HTMLFormElement>(".compare-form");
    const conversation = document.querySelector<HTMLElement>(".conversation");
    if (!form || !conversation) throw new Error("required .compare-form or .conversation section missing");
    const input = form.querySelector<HTMLInputElement>(".compare-input");
    const error = form.querySelector<HTMLElement>(".compare-error");
    if (!input || !error) throw new Error("compare form is missing its input or error slot");

    // [LAW:one-source-of-truth] This paste's slug is read from the one server-rendered
    // data-slug on .conversation — never re-derived from location.pathname.
    const thisSlug = conversation.dataset.slug ?? "";

    // [LAW:dataflow-not-control-flow] reason → message is a total map over the two
    // rejection arms: the pure core owns "is it a slug", the boundary owns the copy.
    const messageFor = (reason: "empty" | "malformed"): string =>
      reason === "empty"
        ? "Enter a paste slug or link to compare with."
        : "That doesn't look like a valid paste slug or link.";

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const ref = parsePasteRef(input.value);
      if (ref.ok) {
        // [LAW:effects-at-boundaries] the sole effect: navigate to the substrate diff route.
        window.location.assign("/diff/" + thisSlug + "/" + ref.slug);
      } else {
        error.textContent = messageFor(ref.reason);
        error.hidden = false;
      }
    });

    // Clear a stale error the moment the reader edits the reference again.
    input.addEventListener("input", () => {
      error.hidden = true;
      error.textContent = "";
    });

    // [LAW:dataflow-not-control-flow] Reveal only now that the one effect is wired.
    document.body.classList.add("compare-ready");
  </script>

  {/*
    ─── The digest ask (slopspot-turn-digest-8xc.44n) ───────────────────────
    The page's ONE affordance for on-device digests, above the conversation it
    is about. It carries no sentence of its own: digestPanel.ts writes the note
    and the button's label on every state change, so the wording lives in one
    place [LAW:one-source-of-truth], and the section stays hidden until that
    module has heard from the browser — a reader whose browser cannot summarize
    never sees it at all [LAW:no-silent-failure].

    The payload is the selected input for each turn, derived above. It rides in
    a hidden <pre> exactly as Listen's utterances do, and only for a
    conversation that has a turn worth digesting.
  */}
  {digestable && (
    <section class="digest-ask" hidden>
      <p class="digest-note"></p>
      {/* .mono-pill is the site's one button chrome — the dock's controls and Listen's
          transport wear it too, so this button cannot look like a different program's
          [LAW:one-source-of-truth]. Its LABEL is digestPanel.ts's, not the markup's. */}
      <button class="digest-open mono-pill" type="button"></button>
      <label class="digest-always"><input type="checkbox" /><span>Always on this device</span></label>
      <progress class="digest-progress" max="1" value="0" hidden></progress>
      <pre class="digest-payload" hidden aria-hidden="true">{JSON.stringify(digestTurns)}</pre>
    </section>
  )}

  {/*
    [LAW:one-source-of-truth] data-slug is the ONE client-readable slug: a projection of
    the server `slug` (Astro.params), carried on the section every client script here
    already depends on. The scripts read it rather than each re-deriving the slug from
    location.pathname — a second derivation that would drift if the URL scheme ever changed.
  */}
  <section class="conversation" aria-label="Conversation" data-slug={slug} set:html={renderDialogueHtml(dialogue)} />

  {/*
    ─── The tool dock ──────────────────────────────────────────────────────────
    Every reader tool this paste offers, gathered into one region at the END of the
    document so the conversation begins directly under its title. The dock has two
    faces, and which one a reader gets is a capability fact, not a branch anyone
    chose [LAW:dataflow-not-control-flow]:

      no JS  — this is a plain block of stacked panels at the foot of the page. Only
               the ungated tools carry content there (outline, version history); the
               CSS hides every `data-requires` panel because none of those body
               classes will ever be added, so no dead control is ever shown.
      JS     — the dock script adds body.tool-dock-ready and the same markup becomes
               a floating launcher pinned to the bottom of the viewport: one icon that
               expands into a horizontal menu, one item per tool, each opening its
               panel above the bar.

    [LAW:one-source-of-truth] The bar items below are rendered from `dockTools`, and
    every panel's presence is `present.<id>` from the SAME map, so a menu item without
    a panel is unwritable here. Each panel addresses itself with TOOL.<id>.id rather
    than a retyped string, making a mismatched id a type error; the dock script still
    asserts the pairing at runtime, since the attribute itself is only a string once
    it reaches the DOM [LAW:no-silent-failure].
  */}
  <div class={DOCK_SELECTORS.dock} data-state="closed">
    <div class={DOCK_SELECTORS.scrim} hidden></div>

    <div class={DOCK_SELECTORS.panelHost}>
      {present.outline && (
        <section class={DOCK_SELECTORS.panel} id={panelDomId(TOOL.outline.id)} data-tool={TOOL.outline.id}
          aria-label={TOOL.outline.hint}>
          <h2 class="tool-panel-title">{TOOL.outline.label}<span class="tool-panel-note">{outline.length} turns</span></h2>
          {/*
            The dock IS the disclosure, so the outline is a bare list here — the
            <details> wrapper it used to carry would be a second collapse around an
            already-collapsed panel.
          */}
          <ol class="spine-outline-list">
            {outline.map((entry) => (
              <li class="spine-outline-item">
                <a class="spine-outline-link" href={`#${entry.anchor}`}>
                  <span class="spine-outline-dot" data-role={entry.role} aria-hidden="true"></span>
                  <span class="spine-outline-label">{entry.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}

      {/*
        [LAW:effects-at-boundaries] Semantic in-page search: the server emits only this
        inert form and an empty results region — the ranked hits are a network fact the
        client fetches from /api/search on demand, never server-rendered state. The
        section stays display:none until its script adds body.search-ready, which is
        also the class that admits this tool to the dock menu, so a no-JS reader is
        never offered a search box that cannot search. aria-live announces each results
        transition (searching → hits / error).
      */}
      {present.search && (
        <section class={DOCK_SELECTORS.panel} id={panelDomId(TOOL.search.id)} data-tool={TOOL.search.id}
          data-requires={requiresAttr(TOOL.search.availability)} aria-label={TOOL.search.hint}>
          <h2 class="tool-panel-title">{TOOL.search.label}</h2>
          <div class="semantic-search">
            <form class="search-form">
              <label class="search-label visually-hidden" for="semantic-search-input">Search this conversation</label>
              <span class="search-field">
                <input class="search-input" id="semantic-search-input" type="search" autocomplete="off"
                  spellcheck="false" placeholder="ask in your own words…" />
                <button class="mono-pill search-go" type="submit">Search</button>
              </span>
            </form>
            <div class="search-results" aria-live="polite"></div>
          </div>
        </section>
      )}

      {/*
        [LAW:effects-at-boundaries] Ask this conversation: the server emits only this
        inert form and an empty answer region — the answer is a network fact the client
        fetches from /api/ask on demand, never server-rendered state. maxlength derives
        from the ONE question bound the server enforces (ask.ts MAX_QUESTION_CHARS) — a
        client courtesy stamped from the same constant, never a second value
        [LAW:one-source-of-truth]. aria-live announces each transition.
      */}
      {present.ask && (
        <section class={DOCK_SELECTORS.panel} id={panelDomId(TOOL.ask.id)} data-tool={TOOL.ask.id}
          data-requires={requiresAttr(TOOL.ask.availability)} aria-label={TOOL.ask.hint}>
          <h2 class="tool-panel-title">{TOOL.ask.label}</h2>
          <div class="semantic-ask">
            <form class="ask-form">
